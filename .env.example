# Server only. Keep actual credentials outside Git.
PUBLIC_ORIGIN=http://localhost:8787
DATABASE_PATH=./balotta.sqlite
PORT=8787
OAUTH_ENABLED=false
MEETINGS_ENABLED=false
MATCHING_ENABLED=false
GROUPS_ENABLED=false
COMMUNITY_ENABLED=false
NOTIFICATIONS_ENABLED=false
# Optional Expo Push: server-only credentials, no cron installed by default.
PUSH_ENABLED=false
PUSH_PROJECT_ID=
PUSH_ENCRYPTION_KEY=
EXPO_ACCESS_TOKEN=
# Verified moderator emails, server only. No user can set their own role.
MODERATOR_EMAILS=
# Native iOS Apple remains disabled until signing, revocation and device tests.
APPLE_NATIVE_ENABLED=false
APPLE_BUNDLE_ID=it.facciamobalotta.app
APPLE_NOTIFICATIONS_ENABLED=false
# Server-only revocation credentials; real P8 belongs in the secret manager.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=
BETA_ALLOWED_EMAILS=
# Public base URL only; never put any API token in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_URL=
# Cloudflare Workers AI — Free plan only, no paid fallback or Gateway credits.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Leave false until the Cloudflare account's Workers Free plan is verified.
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
