{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.3.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.3.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "simulator": {
      "distribution": "internal",
      "node": "24.3.0",
      "ios": {
        "simulator": true
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "beta",
      "node": "24.3.0",
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "preview"
    },
    "production": {
      "extends": "beta",
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
