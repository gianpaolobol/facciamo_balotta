{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facciamo-balotta-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{"binding": "DB", "database_name": "facciamo-balotta", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "ai": {"binding": "AI", "remote": false},
  "rules": [{"type": "Data", "globs": ["**/assets/ai-reference/*.jpg"], "fallthrough": true}],
  "vars": {"PUBLIC_ORIGIN": "https://configure-before-deploy.invalid", "OAUTH_ENABLED": "false", "MEETINGS_ENABLED": "false", "MATCHING_ENABLED": "false", "GROUPS_ENABLED": "false", "COMMUNITY_ENABLED": "false", "NOTIFICATIONS_ENABLED": "false", "PUSH_ENABLED": "false", "INVITATIONS_ENABLED": "false", "APPLE_NATIVE_ENABLED": "false", "APPLE_NOTIFICATIONS_ENABLED": "false", "APPLE_BUNDLE_ID": "it.facciamobalotta.app", "CLOUDFLARE_FREE_PLAN_CONFIRMED": "false", "BETA_ALLOWED_EMAILS": ""},
  "observability": {"enabled": false}
}
